{% block page_scripts %}
<script>
(function () {
  var v = document.getElementById('welcomeVid');
  var btn = document.getElementById('vidUnmute');
  if (!v || !btn) return;

  v.addEventListener('contextmenu', function (e) { e.preventDefault(); });

  function captions(on) {
    var t = v.textTracks && v.textTracks[0];
    if (t) t.mode = on ? 'showing' : 'disabled';
  }

  var attempt = v.play();
  if (attempt && attempt.catch) {
    attempt.catch(function () {
      // Sound blocked by autoplay policy: start muted with captions instead.
      v.muted = true;
      captions(true);
      var muted = v.play();
      if (muted && muted.then) {
        muted.then(function () { btn.style.display = 'inline-flex'; })
             .catch(function () { v.muted = false; captions(false); }); // fully blocked: poster + controls
      }
    });
  }

  function unmuteFromStart() {
    v.muted = false;
    v.currentTime = 0;
    captions(false);
    btn.style.display = 'none';
    var p = v.play();
    if (p && p.catch) p.catch(function () {});
    // The click's default play/pause toggle may pause the video after our
    // handler runs - undo it so unmuting never leaves the video stopped.
    setTimeout(function () { if (v.paused) v.play(); }, 60);
  }

  btn.addEventListener('click', unmuteFromStart);

  // Any click on the (still muted) video itself also unmutes - not just the pill.
  v.addEventListener('click', function (e) {
    if (!v.muted) return;
    e.preventDefault();
    unmuteFromStart();
  });

  v.addEventListener('play', function () {
    if (!v.muted) btn.style.display = 'none';
  });
})();
</script>
{% endblock %}
