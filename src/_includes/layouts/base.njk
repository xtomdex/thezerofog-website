<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
// Theme detection (runs before any CSS to prevent flash)
(function() {
  var saved = localStorage.getItem('zf_theme');
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  var useDark = saved ? saved === 'dark' : prefersDark;
  if (useDark) document.documentElement.classList.add('dark');
})();
</script>
<title>{{ title or site.brand }}</title>
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
{% block head_extras %}{% endblock %}
{% include "partials/pixel-meta.njk" %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/shared.css">
<link rel="stylesheet" href="/assets/css/cookie-consent-2.css">
{% include "partials/head-meta.njk" %}
{% block page_css %}{% endblock %}
</head>
<body>

{% block content %}{% endblock %}

{% include "partials/footer.njk" %}
{% include "partials/cookie-banner.njk" %}

<script src="/assets/js/shared.js" defer></script>
<script src="/assets/js/cookie-consent-3.js" defer></script>
{% block page_scripts %}{% endblock %}

</body>
</html>
