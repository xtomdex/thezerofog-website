<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
// Theme detection (runs before any CSS to prevent flash)
(function() {
  var saved = localStorage.getItem('zf_theme');
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  var useDark = saved ? saved === 'dark' : prefersDark;
  if (useDark) document.documentElement.classList.add('dark');
})();
</script>
<title>{{ title or site.brand }}</title>
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
{% block head_extras %}{% endblock %}
{% include "partials/pixel-meta.njk" %}
<link rel="preload" href="/assets/fonts/inter-var-latin.v1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/shared.css' | v }}">
<link rel="stylesheet" href="{{ '/assets/css/cookie-consent-3.css' | v }}">
{% include "partials/head-meta.njk" %}
{% block page_css %}{% endblock %}
</head>
<body>

{% block content %}{% endblock %}

{% include "partials/footer.njk" %}
{% include "partials/cookie-banner.njk" %}

<script src="{{ '/assets/js/shared.js' | v }}" defer></script>
<script src="{{ '/assets/js/cookie-consent-5.js' | v }}" defer></script>
{% block page_scripts %}{% endblock %}

</body>
</html>
