{# Favicon and app icons #}
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/brand/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/brand/favicon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/brand/apple-touch-icon-180x180.png">

{# Default Open Graph image (pages can override via head_extras block) #}
<meta property="og:image" content="{{ site.url }}/assets/img/brand/og-image-1200x630.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

{# Twitter card upgrade - summary_large_image so the og:image renders big in feed #}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}/assets/img/brand/og-image-1200x630.png">
