{#- Article byline, rendered by layouts/article.njk above the markdown body (the body owns the H1).
    Reads `author` (directory data), `datePublished` and `dateModified` (front matter, quoted
    "YYYY-MM-DD" strings). Dates are spelled out here in Nunjucks so no date filter is needed in
    .eleventy.js; an unparseable date simply drops the date, never the byline. "Updated" appears
    only when dateModified differs from datePublished (GEO rule: the date must be visible). -#}
{%- set months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"] -%}
{%- set d = (datePublished or "") | string -%}
{%- set parts = d.split("-") -%}
{%- set m = (dateModified or "") | string -%}
{%- set mparts = m.split("-") -%}
<p class="article-byline">
  <span class="article-byline__author">{{ author }}</span>
  <span class="article-byline__sep">&middot;</span>
  <a href="/disclaimer/">Not a doctor</a>
  {%- if parts.length == 3 %}
  <span class="article-byline__sep">&middot;</span>
  <time datetime="{{ d }}">{{ parts[2] | int }} {{ months[(parts[1] | int) - 1] }} {{ parts[0] }}</time>
  {%- endif %}
  {%- if mparts.length == 3 and m != d %}
  <span class="article-byline__sep">&middot;</span>
  <span>Updated <time datetime="{{ m }}">{{ mparts[2] | int }} {{ months[(mparts[1] | int) - 1] }} {{ mparts[0] }}</time></span>
  {%- endif %}
</p>
