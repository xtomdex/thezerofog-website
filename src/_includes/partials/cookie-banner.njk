{# Cookie banner with two regime variants; cookie-consent-5.js picks one via
   zf-mode-optin / zf-mode-optout on the banner element (decided by /geo):
   - opt-in (EU/EEA/UK/CH or unknown): consent wording, nothing loads before Accept All.
   - opt-out (elsewhere, incl. US/CCPA): notice wording, trackers already loaded,
     one-click opt out; auto-hides on first scroll.
   The X dismisses without choosing (per session) - not consent, not refusal.
   First layer names purposes only; the vendor list lives in the privacy policy.
   Keep this markup in sync with the inlined banner in src/workshop-text/index.html (passthrough page). #}
<div id="zf-cookie-banner" role="dialog" aria-label="Cookie consent">
  <button type="button" class="zf-cb-close" aria-label="Close" onclick="zfDismissBanner()">&times;</button>
  <div class="zf-cb-inner">
    <div class="zf-cb-text zf-v-optin">
      <strong>We use cookies.</strong> Essential cookies keep this site working. With your consent we also use analytics and advertising cookies. Details in our <a href="/privacy/">Privacy Policy</a>.
    </div>
    <div class="zf-cb-text zf-v-optout">
      <strong>We use cookies</strong> for analytics and advertising. You can opt out anytime. Details in our <a href="/privacy/">Privacy Policy</a>.
    </div>
    <div class="zf-cb-actions zf-v-optin">
      <button type="button" class="zf-cb-btn-essential" onclick="zfSetConsent('essential')">Essential Only</button>
      <button type="button" class="zf-cb-btn-accept" onclick="zfSetConsent('all')">Accept All</button>
    </div>
    <div class="zf-cb-actions zf-v-optout">
      <button type="button" class="zf-cb-btn-essential" onclick="zfSetConsent('essential')">Opt out</button>
      <button type="button" class="zf-cb-btn-accept" onclick="zfSetConsent('all')">OK</button>
    </div>
  </div>
</div>
