  <h1>Privacy Policy</h1>

  <div class="legal-meta">
    <p><strong>The Zero Fog</strong></p>
    <p>Website: {{ site.domain }}</p>
    <p>Effective Date: 2026-04-28</p>
    <p>Last Updated: 2026-08-19</p>
