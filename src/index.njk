{% block page_scripts %}
<script src="{{ '/assets/js/pages/index.js' | v }}" defer></script>
<script>
/* Handover from /hours. The number never travels in the URL - it is an estimate of
   what this person earns, and a query string lands in browser history and referers.
   Same-origin sessionStorage carries it instead. Read once, then dropped, so a
   later visit does not replay a stale figure. */
(function(){
  var n;
  try { n = sessionStorage.getItem("zf_hours_year"); sessionStorage.removeItem("zf_hours_year"); }
  catch (e) { return; }
  if (!n || !/^[\d,]{1,7}$/.test(n)) return;
  var strip = document.getElementById("countedStrip");
  var slot = document.getElementById("countedHours");
  if (!strip || !slot) return;
  slot.textContent = n;
  strip.hidden = false;
})();

/* LIVE since 2026-08-26. Reads utm_content, which the ads already carry, and echoes
   that ad's own opening line. No promise is made here: the answer stays inside the
   workshop, this line only confirms the door. */
(function(){
  var LINES = {
    a1:  "It was never a discipline problem.",
    /* a2 has no callback line: the H1 itself now carries "three years" and "lazy",
       and repeating both two lines apart reads as a stutter. */
    a11: "Everything came back normal. I still could not think."
  };
  var k;
  try { k = new URLSearchParams(location.search).get("utm_content"); }
  catch (e) { return; }
  if (!k) return;
  var line = LINES[String(k).toLowerCase()];
  if (!line) return;
  var el = document.getElementById("hookCallback");
  if (!el) return;
  el.textContent = line;
  el.hidden = false;
})();
</script>
{% endblock %}
