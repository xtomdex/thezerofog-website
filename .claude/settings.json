{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",

      "Edit(./src/**)",
      "Edit(./netlify/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.env.example)",
      "Edit(./netlify.toml)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./_redirects)",
      "Edit(./.eleventy.js)",
      "Edit(./.gitignore)",
      "Edit(./.nvmrc)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",

      "Write(./src/**)",
      "Write(./netlify/**)",
      "Write(./CLAUDE.md)",
      "Write(./.env.example)",
      "Write(./netlify.toml)",
      "Write(./package.json)",
      "Write(./package-lock.json)",
      "Write(./_redirects)",
      "Write(./.eleventy.js)",
      "Write(./.gitignore)",
      "Write(./.nvmrc)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/settings.local.json)",

      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(pwd)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",

      "Bash(node --version)",
      "Bash(node:*)",
      "Bash(npm run build)",
      "Bash(npm run clean)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm ci:*)",
      "Bash(npx eleventy)",
      "Bash(npx eleventy:*)",

      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git config --get:*)",

      "Bash(git add:*)",
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",

      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(git gc --aggressive:*)",
      "Bash(git update-ref:*)",

      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",

      "Edit(./_archive-**)",
      "Edit(./_archive-*/**)",
      "Write(./_archive-**)",
      "Write(./_archive-*/**)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm --recursive:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)"
    ],
    "ask": [
      "Bash(npm install -g:*)",
      "Bash(npm install --global:*)",
      "Bash(npm i -g:*)",
      "Bash(npm i --global:*)",

      "Bash(sudo:*)",
      "Bash(brew:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pipx:*)",

      "Bash(chmod:*)",
      "Bash(chown:*)",

      "WebFetch"
    ]
  }
}
