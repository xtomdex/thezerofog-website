# Local env template. Copy to `.env` and fill in real values.
# `.env` is gitignored. `netlify dev` auto-loads it. In prod, set the same vars
# in Netlify UI → Site settings → Environment variables.
#
# Conventions:
# - PUBLIC_*  → exposed to client-side templates via src/_data/*.js
# - others    → server-only, available to netlify/functions/* exclusively

# ─── Site identity (src/_data/site.js) ───────────────────────────────────────
# Defaults render reasonably without these set. Override per environment.

PUBLIC_SITE_DOMAIN=thezerofog.com
PUBLIC_SITE_URL=https://thezerofog.com

# Legal entity name as it should appear in legal documents. No safe default — must be set.
PUBLIC_LEGAL_ENTITY=

# Tax identification number (NIF/NIE), published per LSSI-CE Art. 10. No safe default.
PUBLIC_LEGAL_TAX_ID=

# Commercial postal address, published per LSSI-CE Art. 10.
# Split into parts so templates can compose either a one-line or multi-line form.
PUBLIC_LEGAL_ADDRESS_LINE1=
PUBLIC_LEGAL_ADDRESS_LINE2=
PUBLIC_LEGAL_POSTAL_CODE=
PUBLIC_LEGAL_CITY=
PUBLIC_LEGAL_COUNTRY=

# Contact emails. If unset, derived as <local-part>@${PUBLIC_SITE_DOMAIN}.
PUBLIC_EMAIL_SUPPORT=
PUBLIC_EMAIL_PRIVACY=
PUBLIC_EMAIL_REFUNDS=
PUBLIC_EMAIL_COPYRIGHT=

# ─── Public client-side (src/_data/env.js) ───────────────────────────────────
# Exposed to the browser at build time — NOT secrets. Safe to ship publicly.

# Meta (Facebook) Pixel ID. Public, client-side ID (not a secret). When set, it is
# exposed to client JS and the Meta Pixel loads ONLY after marketing-cookie consent
# ('all'). Leave empty to ship the site fully pixel-free.
META_PIXEL_ID=0000000000000000

# PostHog funnel analytics (Cloud US, free tier; account owner = Kirill).
# Project API key (phc_...) is public/client-side, not a secret. When set, PostHog
# (autocapture + session recordings, inputs masked) loads ONLY after cookie consent
# ('all'), same gate as the pixel. Leave empty to ship the site analytics-free.
# Plan: /Users/Cyrill/AI SANDBOX/_Marketing/POSTHOG-FUNNEL-ANALYTICS-PLAN-2026-07-12.md
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Supabase (public client config, exposed to /app via generated dist/app/config.js) ───
# These are PUBLIC (anon key is meant to be client-side; RLS protects the data). Sourced from env,
# emitted into dist/app/config.js at build time — NOT hardcoded.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ─── Server-only (netlify/functions/*) ───────────────────────────────────────
# NEVER use a PUBLIC_ prefix for these — they must not reach the client.

# ─── Supabase server-side (SECRET — never client-side, never in dist/app/config.js) ───
# Used by netlify/functions to provision the app user + profile on purchase (and account deletion).
# This is the Supabase SECRET key (sb_secret_...). Server-only. Set in Netlify env, never committed.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Every MAKE_* variable is gone as of 2026-08-16 - Make is out of the funnel and has no reader
# left in the code: leads are written by optin.js, payments enrol from stripe-webhook.js, email
# is delivered straight to MailerLite, and a room question now pushes to Telegram below.
MAILERLITE_API_KEY=

# Operator alerts (netlify/functions/lib/wr-telegram.js). Today's only caller is wr-question.js:
# the room promises "Kirill reads these himself", and this is what makes that true.
# Unset is safe and silent-by-design in previews - the question is still stored in wr_events and
# still listed by wr-stats; only the push is lost. Both server-only, never PUBLIC_.
# Token comes from @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates after
# sending the bot one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe Checkout (netlify/functions/create-checkout.js).
# STRIPE_SECRET_KEY is server-only — NEVER expose to the client.
STRIPE_SECRET_KEY=<your secret>
# The $67 one-time Founding Member price, created in the Stripe dashboard.
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Workshop room (our own session system, replaces EverWebinar) ─────────────
# The room is served from our own pages and Netlify Functions. It needs no vendor
# key: it runs on SUPABASE_URL + SUPABASE_SECRET_KEY (above) and MAKE_WEBHOOK_URL.
#
# EVERWEBINAR_SCHEDULE_URL is GONE. optin.js used to read it and return 500 when it
# was unset, which killed the lead before it ever reached Make. It now redirects to
# our own schedule step and there is nothing here that can be missing.

# Override the schedule step's path. Leave unset in production - it exists so a Deploy
# Preview can point somewhere else.
# WORKSHOP_SCHEDULE_PATH=/workshop/schedule/

# Shared key protecting /.netlify/functions/wr-stats, which returns registrant email
# addresses and watch behaviour. Without it the endpoint answers 404 to everyone.
# Generate with: openssl rand -base64 32
WORKSHOP_ADMIN_KEY=

# Stripe webhook (netlify/functions/stripe-webhook.js).
# Signing secret used to verify the Stripe-Signature header. Server-only.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Systeme.io public API key (Settings -> Public API keys). The webhook enrolls the
# buyer into the course with it. Unset = every paid order answers 500 and Stripe
# retries until it is set — an order is delayed, never lost.
SYSTEME_API_KEY=
# Course to enroll buyers into. Defaults to 606107 ("4 Week Protocol") when unset.
# SYSTEME_COURSE_ID=606107
# Tag the webhook puts on a contact after a FULL refund, once the enrollment is already
# deleted. It is the record of who was refunded, and it fires Systeme's `Refunded`
# workflow (Tag added -> Revoke access to a course) as a second line of defence.
# Defaults to 2134135 ("refunded") when unset.
# SYSTEME_REFUNDED_TAG_ID=2134135
# Expected paid amount in cents (e.g. 6700 for $67) — validated before enrolling.
EXPECTED_AMOUNT_TOTAL=6700
# Expected currency (lowercase ISO code, e.g. usd) — validated before enrolling.
EXPECTED_CURRENCY=usd

# monday.com operations board. Personal API token from monday.com -> avatar -> Developers ->
# My access tokens. UNSET = stripe-webhook.js writes nothing to monday and logs nothing about it;
# every other step of the payment path is unaffected. Never a reason to fail an order.
MONDAY_API_TOKEN=
# Optional board overrides. Defaults are the boards built 2026-08-18:
# MONDAY_BOARD_CUSTOMERS=5102474399
# MONDAY_BOARD_MONEY=5102474401

# Shared key gating wr-course-complete.js (Systeme 'Send webhook' rule carries it as ?key=)
SYSTEME_WEBHOOK_KEY=
